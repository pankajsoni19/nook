PORT=2026
DATA_DIR=/data
MYNOTES_DATA_DIR=/srv/mynotes
APP_ORIGIN=http://localhost:2026
APP_ORIGINS=http://localhost:2026,https://your-device.your-tailnet.ts.net
# The name in tab titles, link previews, the installed app, mail, and the authenticator app (default Nook).
# One line, 1 to 40 characters, no < or >. Example: APP_NAME=Acme Notes
APP_NAME=
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
ALLOWED_EMAILS=first.user@example.com,second.user@example.com
# Team role of accounts registered after the first (the first is admin): guest, viewer, or member.
SIGNUP_ROLE=member
TOTP_POLICY=optional
# Sign-in methods: password (default), google, or both. Google needs an OAuth client (Web application)
# whose redirect URI is exactly APP_ORIGIN/api/auth/google/callback; see docs/OPERATIONS.md, Google sign-in.
AUTH_METHODS=password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only Google accounts on these email domains may sign in or be created (e.g. example.com).
GOOGLE_ALLOWED_DOMAINS=
# Reverse proxies in front of Nook that add X-Forwarded-For (0-5): 0 = none, 1 = one reverse proxy or
# Tailscale Serve. Rate limits, logs, and API keys limited to addresses. Never set it above 0 without that many proxies in front.
TRUSTED_PROXY_HOPS=0
# The proxies' own addresses or CIDR ranges, comma-separated (e.g. 127.0.0.1,172.16.0.0/12). When set,
# X-Forwarded-For is read only from these connections; empty trusts it from any (with a startup warning).
TRUSTED_PROXY_ADDRESSES=
TOTP_ENCRYPTION_KEY=
# The Vault's key (off while empty). Generate with: openssl rand -base64 32
# It must differ from TOTP_ENCRYPTION_KEY. Keep a copy away from where backups are stored: an archive
# plus this key opens every vault secret, and without it no vault can be read.
VAULT_ENCRYPTION_KEY=
# Or the absolute path of a file holding it (a Docker secret), outside DATA_DIR; not both.
VAULT_ENCRYPTION_KEY_FILE=
# Agent chat (the Chat module): the key that seals model-provider API keys (off while empty). Generate with:
# openssl rand -base64 32. It must differ from TOTP_ENCRYPTION_KEY and VAULT_ENCRYPTION_KEY; keep it away from backups.
AGENT_SECRETS_KEY=
# Or the absolute path of a file holding it (a Docker secret), outside DATA_DIR; not both.
AGENT_SECRETS_KEY_FILE=
# Hosts the server may call for models although they are on a private network (comma-separated host
# names, IP addresses, or CIDR ranges, e.g. ollama,10.0.0.0/8). Plain http is allowed only for these.
AGENT_ALLOWED_PRIVATE_HOSTS=
# Chats answered at once for the whole instance (1-32), and the wall clock of one answer in seconds (30-3600).
AGENT_MAX_CONCURRENT_RUNS=4
AGENT_RUN_TIMEOUT_S=600
# Days the agent Audit log keeps API and MCP runs (7-365); an admin's Settings -> AI value, when stored, wins.
AGENT_AUDIT_RETENTION_DAYS=30
# stdio MCP servers (off by default; never from the UI). "on" reads the host's declaration file below at startup:
# a JSON array of { id, name, command (absolute path), args, env }. Prefer an HTTP bridge container (docs/OPERATIONS.md).
AGENT_MCP_STDIO=off
AGENT_MCP_STDIO_FILE=
# The embedding model built into Nook (knowledge bases with no outside provider). "on" lets an admin add it in
# Settings -> AI; "off" forbids it. The image carries its files; elsewhere fetch them with scripts/fetchLocalModel.ts
# into an absolute directory outside DATA_DIR (empty: ./models/<model id> next to server/).
LOCAL_EMBEDDINGS=on
LOCAL_EMBEDDINGS_DIR=
# Which local model runs: "multilingual" (multilingual-e5-small, about 100 languages, about 0.8 GB while loaded)
# or "english" (bge-small-en-v1.5, English only, about 0.3 GB). Switching re-embeds nothing by itself: each
# knowledge base on the other model searches by keywords until its owner uses Change embedding model.
LOCAL_EMBEDDINGS_VARIANT=multilingual
# Build time (docker compose build): "include" bundles the multilingual model (135 MB), "english" only the English
# one (35 MB), "all" both (170 MB), "skip" none; then put the files in LOCAL_EMBEDDINGS_DIR (a mounted directory).
LOCAL_EMBEDDINGS_MODEL=include
SESSION_DAYS=14
MAX_MARKDOWN_BYTES=2000000
# Files: largest upload (1 MiB to 2 GiB), per-user quota incl. Bin (0 = unlimited), free-disk floor.
MAX_UPLOAD_BYTES=104857600
USER_STORAGE_QUOTA_BYTES=10737418240
MIN_FREE_DISK_BYTES=1073741824
# File storage: local (DATA_DIR, the default) or s3. SQLite always stays in DATA_DIR.
# With s3 the server probes the bucket at startup and refuses to start if anything is missing.
# See docs/OPERATIONS.md, S3 storage, and server/storage-admin.ts to copy files between backends.
STORAGE_BACKEND=local
S3_BUCKET=
# S3-compatible services (MinIO, R2, B2): their https origin. Empty = AWS S3 in S3_REGION.
S3_ENDPOINT=
S3_REGION=
# Or S3_ACCESS_KEY_ID_FILE / S3_SECRET_ACCESS_KEY_FILE (absolute paths outside DATA_DIR), never both.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY_FILE=
S3_PREFIX=
# true only for a plain-http endpoint on a private network you trust.
S3_ALLOW_HTTP=false
# Deadline for one S3 request in milliseconds (a part upload gets four times this).
S3_TIMEOUT_MS=30000
# Online backups (docs/OPERATIONS.md, Backup and restore): the server snapshots the database (VACUUM INTO)
# and packs the data directory into a verified .tar.gz without stopping, on this schedule. Settings → Backups
# shows them; `bun server/backup-admin.ts` runs them by hand, lists them, and restores.
BACKUP_ENABLED=true
# How often: a number and m, h, d, or w (15m to 30d).
BACKUP_INTERVAL=1d
# How many archives to keep in each place (older ones are deleted; only nook-backup-*.tar.gz names).
BACKUP_KEEP=14
# Where: local (DATA_DIR/backup, or BACKUP_DIR), s3, or both. Empty = s3 with STORAGE_BACKEND=s3, else local.
BACKUP_TARGET=
# Another folder for local archives (absolute; mount it into the container). Empty = DATA_DIR/backup.
BACKUP_DIR=
# Archives go under <S3_PREFIX><BACKUP_S3_PREFIX> in the S3_* bucket (S3_BUCKET works with local files too).
BACKUP_S3_PREFIX=backups/
# required: an archive the bucket did not encrypt at rest (its default encryption) is removed and the run fails.
BACKUP_S3_SSE=off
# Optional: a bucket of their own for backups and Litestream, with its own settings (as the S3_* ones).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ACCESS_KEY_ID_FILE=
BACKUP_S3_SECRET_ACCESS_KEY_FILE=
# Admins get a bell notice (and mail, when mail is on) after this many failed runs in a row.
BACKUP_ALERT_AFTER=2
# A scheduled restore drill (restore the newest archive into a scratch folder and check it): off or e.g. 7d.
BACKUP_DRILL_INTERVAL=off
# Litestream: continuous replication of the database to the backup bucket, for point-in-time restore.
# Needs an S3 bucket (as for backups). Restart the container after changing it.
LITESTREAM_ENABLED=false
LITESTREAM_S3_PREFIX=litestream/
# How far back a point-in-time restore can go (and how long Litestream keeps its snapshots).
LITESTREAM_RETENTION=7d
# Litestream's metrics inside the container (Settings → Backups reads them); empty turns them off.
LITESTREAM_METRICS_ADDR=127.0.0.1:9090
# Build without the Litestream binary (39 MB): LITESTREAM=skip.
LITESTREAM=include
# Web Push for calendar reminders: auto (on only for an https APP_ORIGIN), true, or false.
PUSH_ENABLED=auto
# VAPID contact; defaults to APP_ORIGIN. Use an https URL or mailto: address.
PUSH_SUBJECT=
# Extra push-service hosts beyond the built-in list, comma-separated (e.g. *.push.example.com).
PUSH_ENDPOINT_HOSTS=
# Outbound email through Resend (https://resend.com). Email is off unless both are set.
# MAIL_FROM is an address or "Display Name <address@your-domain>" on a domain verified in Resend.
# Failures are logged as error name, HTTP status, and a hashed recipient only; the Resend SDK's own
# error logging (full provider bodies, which can quote addresses, outside NODE_ENV=production) is off.
RESEND_API_KEY=
MAIL_FROM=
# Links in mail use APP_ORIGIN, which must be https (or set MAIL_ALLOW_HTTP_LINKS=true for a LAN/Tailscale http origin).
MAIL_ALLOW_HTTP_LINKS=false
# Shown in each mail's header and footer (defaults to the APP_ORIGIN host); one line, at most 40 characters.
MAIL_INSTANCE_NAME=
# Messages a day for the instance (1-10000). Resend's free tier allows 100.
MAIL_DAILY_LIMIT=500
# Optional: the signing secret (whsec_...) of a Resend webhook pointed at APP_ORIGIN/api/mail/webhook,
# for bounces and spam complaints. Leave empty to keep the endpoint off (it answers 404).
RESEND_WEBHOOK_SECRET=
# Logs (docs/OPERATIONS.md, Logs): follow them with `docker compose logs -f app`.
# LOG_LEVEL: error, warn, info (default), or debug. debug adds health checks, static files, and query SQL.
LOG_LEVEL=info
# LOG_FORMAT: pretty (one readable line per event) or json (one object per line, for a log shipper).
LOG_FORMAT=pretty
# Requests slower than this many milliseconds log at warn.
LOG_SLOW_MS=1000
